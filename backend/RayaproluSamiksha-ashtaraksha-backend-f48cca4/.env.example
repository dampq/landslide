# Copy to .env INSIDE this backend folder. Never commit .env.
DATABASE_PATH=./backend.sqlite3
CORS_ORIGIN=http://localhost:5173
MAX_USER_MEDIA_BYTES=100000000
# Optional trained model from train_model.py. Empty uses the screening index.
MODEL_PATH=
# Default does not send external messages. Explicitly opt in after configuring a provider.
NOTIFICATION_MODE=dry-run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional HTTPS image classification service accepting {imageBase64,mimeType}.
VISION_ENDPOINT=
VISION_API_KEY=
