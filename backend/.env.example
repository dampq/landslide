# Export these variables in the process environment (no automatic .env loading).
DATABASE_URL=postgresql+psycopg://ashtaraksha:local-development@127.0.0.1:5433/ashtaraksha
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Set true behind HTTPS for deployment. Local development uses HTTP.
COOKIE_SECURE=false
# Optional external model artifact, never trained or downloaded by this project.
RF_MODEL_PATH=
RF_MODEL_SHA256=
